# The token everything derives from. While this is empty the site runs on
# placeholder data — set it and every figure becomes real.
VITE_MINT=

# Birdeye API key for the price / market cap / volume / holders strip.
# WARNING: Vite inlines this into the public bundle. It is not a secret once
# deployed — use a key you are happy to have read, and rotate it if abused.
VITE_BIRDEYE_KEY=

# Optional: hours of silence that exhaust a layer (default 6).
VITE_LIFE_HOURS=

# Force placeholder data even with a mint set.
VITE_DEMO=
